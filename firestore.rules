rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /schedule_items/{scheduleId} {
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow read, delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
    }

    match /daily_tasks/{taskId} {
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /sleep_records/{recordId} {
      // get: 未作成ドキュメント（resource == null）でも自UIDのIDなら許可（目覚まし開始の getDoc 用）
      // list: user_id クエリと整合させ、一覧・健康生活PDFが空にならないようにする
      allow get: if isSignedIn() && (
        (resource == null && recordId.matches('^' + request.auth.uid + '_.*'))
        || (resource != null && resource.data.user_id == request.auth.uid)
      );
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && recordId == request.auth.uid + '_' + request.resource.data.date;
      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // 目覚ましアラーム状態（ドキュメントID = uid）
    match /sleep_alarm_state/{userId} {
      allow create, read, update, delete: if isOwner(userId);
    }

    // 服薬時刻・通知設定（ドキュメントID = uid）
    match /medication_settings/{userId} {
      allow create, read, update, delete: if isOwner(userId);
    }

    // 日次服薬・体調記録（ドキュメントID = `${uid}_${date}`。見守り参照用の conditionLevel / conditionNote 含む）
    match /medication_records/{recordId} {
      allow get: if isSignedIn() && (
        (resource == null && recordId.matches('^' + request.auth.uid + '_.*'))
        || (resource != null && resource.data.user_id == request.auth.uid)
      );
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && recordId == request.auth.uid + '_' + request.resource.data.date;
      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /fcm_tokens/{tokenId} {
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /notification_state/{userId} {
      allow create, read, update, delete: if isOwner(userId);
    }

    match /common_titles/{userId} {
      allow create, read, update, delete: if isOwner(userId);
    }

    match /notification_logs/{logId} {
      allow read, write: if false;
    }

    // 自分のメールの購読情報のみ参照可（書き込みは Stripe 等の管理側）
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn()
        && resource.data.email is string
        && resource.data.email == request.auth.token.email;
      allow create, update, delete: if false;
    }

    // 見守りプロフィール（本人のみ）
    match /watch_profiles/{userId} {
      allow create, read, update, delete: if isOwner(userId);
    }

    // 契約メールからの見守り人検索用（認証済みの get のみ。list 不可）
    match /watch_email_index/{emailKey} {
      allow get: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.role in ['watcher', 'requester'];
      allow delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow list: if false;
    }

    // 見守りマッチ（当事者のみ）
    match /watch_matches/{matchId} {
      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.watcherUid is string
        && request.resource.data.status == 'pending_approval';
      allow read: if isSignedIn()
        && (resource.data.watcherUid == request.auth.uid
          || resource.data.requesterUid == request.auth.uid);
      allow update: if isSignedIn()
        && (resource.data.watcherUid == request.auth.uid
          || resource.data.requesterUid == request.auth.uid)
        && request.resource.data.watcherUid == resource.data.watcherUid
        && request.resource.data.requesterUid == resource.data.requesterUid;
      allow delete: if false;
    }

    // 見守り共有イベント（依頼人が作成、当事者が閲覧）
    match /watch_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.watcherUid is string
        && request.resource.data.matchId is string
        && request.resource.data.kind in ['bedtime', 'wake', 'medication', 'condition'];
      allow read: if isSignedIn()
        && (resource.data.watcherUid == request.auth.uid
          || resource.data.requesterUid == request.auth.uid);
      allow update, delete: if false;
    }

    // 見守りコメント（当事者が作成・閲覧。終了後は作成不可はアプリ側で制御）
    match /watch_comments/{commentId} {
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.matchId is string
        && (request.resource.data.watcherUid == request.auth.uid
          || request.resource.data.requesterUid == request.auth.uid);
      allow read: if isSignedIn()
        && (resource.data.watcherUid == request.auth.uid
          || resource.data.requesterUid == request.auth.uid);
      allow update, delete: if false;
    }
  }
}
